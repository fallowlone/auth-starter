# Copy to .env. Never commit real values.
DATABASE_URL=postgresql://app:app@localhost:5432/app
JWT_SECRET=change-me-to-32-plus-random-chars-0000000000
# Public URL of the web app (OAuth redirect and CORS origin)
APP_URL=http://localhost:5173
# Optional: Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
